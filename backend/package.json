{
  "name": "habit-tracker-backend",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "db:migrate": "prisma migrate dev",
    "seed:demo": "tsx --env-file=.env src/scripts/seed-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1",
    "@fastify/helmet": "^13.2",
    "@fastify/oauth2": "^8.3",
    "@fastify/rate-limit": "^11.2",
    "@fastify/websocket": "^11.3",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.12",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8",
    "prisma": "7.10.1",
    "tsx": "^4.23",
    "typescript": "~6.0.0",
    "vitest": "^4.1"
  }
}
